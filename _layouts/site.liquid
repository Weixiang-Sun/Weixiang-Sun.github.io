<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if page.title and page.nav != "home" %}{{ page.title }} · {% endif %}Weixiang (Sweson) Sun</title>
<meta name="description" content="{{ page.description | default: site.description | strip_html | strip_newlines | strip | escape }}">
<meta name="author" content="Weixiang Sun">
<meta name="color-scheme" content="light dark">
<link rel="canonical" href="{{ page.url | absolute_url }}">
<link rel="icon" href="{{ '/assets/img/favicon.svg' | relative_url }}" type="image/svg+xml">
<script>try { var t = localStorage.getItem("theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Instrument+Sans:wght@400..600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
{% include site/styles.css %}
</style>
{% feed_meta %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="{{ '/' | relative_url }}">Weixiang Sun</a>
    <nav class="site-nav" aria-label="Main">
      <a class="u" href="{{ '/' | relative_url }}"{% if page.nav == "home" %} aria-current="page"{% endif %}>Home</a>
      <a class="u" href="{{ '/publications/' | relative_url }}"{% if page.nav == "publications" %} aria-current="page"{% endif %}>Publications</a>
      <a class="u" href="{{ '/projects/' | relative_url }}"{% if page.nav == "projects" %} aria-current="page"{% endif %}>Projects</a>
      <a class="u" href="{{ '/blog/' | relative_url }}"{% if page.nav == "blog" %} aria-current="page"{% endif %}>Blog</a>
      <a class="u" href="{{ '/assets/pdf/WeixiangSun_CV.pdf' | relative_url }}" target="_blank" rel="noopener">CV<span class="ext">↗</span></a>
    </nav>
    <button type="button" class="theme-btn" id="theme-toggle" aria-label="Switch color theme">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/></svg>
    </button>
  </div>
</header>

<main id="main">
{{ content }}
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <span>© {{ site.time | date: "%Y" }} Weixiang Sun</span>
    <span>Last updated <time datetime="{{ site.time | date: '%Y-%m-%d' }}">{{ site.time | date: "%b %-d, %Y" }}</time></span>
  </div>
</footer>

{% if page.pubs %}
<dialog class="lightbox" id="lightbox" aria-labelledby="lb-title">
  <div class="lb-plate"><img id="lb-img" alt=""></div>
  <div class="lb-meta">
    <p class="lb-cap" id="lb-cap"></p>
    <p class="lb-title" id="lb-title"></p>
    <div class="lb-actions">
      <a class="u" id="lb-link" href="#" target="_blank" rel="noopener">Open paper<span class="ext">↗</span></a>
      <button type="button" class="btn btn-sm" id="lb-close">Close</button>
    </div>
  </div>
</dialog>
<script id="pubs-data" type="application/json">{{ site.data.publications | jsonify }}</script>
{% endif %}

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="{{ '/assets/js/site.js' | relative_url }}" defer></script>
</body>
</html>
