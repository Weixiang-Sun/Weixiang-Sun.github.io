---
layout: site
nav: blog
---
{%- assign words = content | number_of_words -%}
{%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
<article class="view">
  <div class="wrap">
    <div class="article">
      <a class="back u" href="{{ '/blog/' | relative_url }}">← Blog</a>
      <p class="article-meta"><time datetime="{{ page.date | date: '%Y-%m-%d' }}">{{ page.date | date: "%B %-d, %Y" }}</time><span>·</span><span>{{ minutes }} min read</span></p>
      <h1 class="article-title">{{ page.title }}</h1>
      {%- if page.description %}
      <p class="article-dek">{{ page.description }}</p>
      {%- endif %}
      <div class="prose article-body">
        {{ content }}
      </div>
    </div>
  </div>
</article>
