{%- assign target = page.redirect_to | relative_url -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Redirecting…</title>
<link rel="canonical" href="{{ target | absolute_url }}">
<meta http-equiv="refresh" content="0; url={{ target }}">
<meta name="robots" content="noindex">
</head>
<body>
<p>This page has moved to <a href="{{ target }}">{{ target | absolute_url }}</a>.</p>
</body>
</html>
